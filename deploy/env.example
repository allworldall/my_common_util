# 复制到线上：/etc/service_env/my_common_util
# systemd 的 EnvironmentFile 会加载这里的变量
#
# Spring 环境由 systemd unit 固定为 prod（SPRING_PROFILES_ACTIVE=prod），
# 一般不必在这里再写 profile。差异配置写在 application-prod.yaml。

# 可选：覆盖启动脚本默认值
# APP_HOME=/var/app/my_common_util
# LOG_DIR=/var/app/my_common_util/logs
# JAR=/var/app/my_common_util/my_common_util-0.0.1-SNAPSHOT.jar
# 必须用 JDK 21（不要写 /usr/bin/java：线上默认可能是 Java 11，会导致 502）
JAVA_BIN=/usr/lib/jvm/java-21/bin/java

# 业务环境变量（密钥只放服务器，勿提交仓库）
MAIL_USERNAME=249191841@qq.com
MAIL_AUTH_CODE=scqwtlshcatmcajb

# 可选：覆盖 application-prod.yaml 里的转换工具路径
# DOC_CONVERT_SOFFICE_PATH=/usr/bin/soffice
# 线上默认 python3 常是 3.6，过旧装不了 pdf2docx；请用 python3.8+
DOC_CONVERT_PYTHON_BIN=/usr/bin/python3.8
DOC_CONVERT_PDF2DOCX_SCRIPT=/var/app/my_common_util/pdf2docx_convert.py
