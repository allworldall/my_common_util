# 复制一份并改名后使用（勿提交真实文件）：
#   cp deploy/deploy.env.example deploy/deploy.env
# 多套发布目标可再建：
#   deploy/deploy.env.prod / deploy/deploy.env.staging
#
# 发布：
#   ./deploy/release.sh
#   ./deploy/release.sh prod
#
# 注意：这里的 prod 是「发布到哪台机器」的配置文件名，
# 应用运行环境（Spring profile）由服务器 systemd 的 SPRING_PROFILES_ACTIVE=prod 控制。

DEPLOY_HOST=your.server.com
DEPLOY_USER=webuser
DEPLOY_SSH_PORT=22

# 后端目录（jar + start.sh + logs）
APP_HOME=/var/app/my_common_util

# 前端静态目录（与 nginx root 一致）
FRONTEND_REMOTE=/var/app/my_common_util/frontend

# systemd 服务名
SERVICE_NAME=my-common-util

# 非 root 时默认用 sudo 执行 systemctl；一般不用改
# DEPLOY_USE_SUDO=1

# 对外访问根地址（无末尾斜杠）。用于 robots.txt / sitemap / canonical。
# 例：https://tools.example.com
SITE_ORIGIN=https://tools.example.com
