#!/usr/bin/env bash
# 本地 SSH 密码（含密码，勿提交 Git）
#
# 用法：
#   1) cp deploy/ssh-with-pass.local.example deploy/ssh-with-pass.local.sh
#   2) 只改下面这一行，粘贴密码
#   3) chmod 600 deploy/ssh-with-pass.local.sh
#   4) 交互登录：./deploy/ssh-with-pass.local.sh
#   5) 发布：./deploy/release.sh（自动带上密码，无需手输）
#
# 原理：复用系统自带的 ssh（SSH_ASKPASS），不额外安装软件。

# ========== 只改这一处 ==========
DEPLOY_SSH_PASS='在这里粘贴密码'
# ================================

export DEPLOY_SSH_PASS

# 被 release.sh source 时到此结束
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="${DEPLOY_ENV_FILE:-$ROOT/deploy/deploy.env}"
ASKPASS="$SCRIPT_DIR/ssh-askpass.sh"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "缺少 $ENV_FILE"
  exit 1
fi
# shellcheck disable=SC1090
source "$ENV_FILE"

: "${DEPLOY_HOST:?}"
: "${DEPLOY_USER:?}"
DEPLOY_SSH_PORT="${DEPLOY_SSH_PORT:-22}"

if [[ -z "${DEPLOY_SSH_PASS}" || "$DEPLOY_SSH_PASS" == "在这里粘贴密码" ]]; then
  echo "请先在 deploy/ssh-with-pass.local.sh 里填写 DEPLOY_SSH_PASS"
  exit 1
fi

chmod +x "$ASKPASS" 2>/dev/null || true
export SSH_ASKPASS="$ASKPASS"
export SSH_ASKPASS_REQUIRE=force
export DISPLAY="${DISPLAY:-:0}"

# 不占用终端输入，让 ssh 走 ASKPASS
exec ssh \
  -p "$DEPLOY_SSH_PORT" \
  -o StrictHostKeyChecking=accept-new \
  -t \
  "${DEPLOY_USER}@${DEPLOY_HOST}" \
  "$@" < /dev/null
